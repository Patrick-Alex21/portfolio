<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    background: var(--black);
  }

  .hero-photo-bg {
    position: absolute;
    right: 20px;
    width: 55%; height: 150%;
    background-image: url('/HeroPic.webp');
    background-size: cover;
    background-position: center top;
    filter: grayscale(100%) brightness(0.8) contrast(1.1);
    mask-image: linear-gradient(to right, transparent 0%, rgba(0,0,0,0.6) 30%, rgba(0,0,0,0.9) 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 0%, rgba(0,0,0,0.6) 30%, rgba(0,0,0,0.9) 100%);
  }
  .hero-photo-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, transparent 40%, rgba(0,229,255,0.06) 100%);
    mix-blend-mode: screen;
  }

  .hero-photo-bg:hover {
    filter: grayscale(0%) brightness(0.4) contrast(1.2); /* "Heals" the image on hover */
    transform: scale(1.02);
    transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(0,229,255,0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0,229,255,0.03) 1px, transparent 1px);
    background-size: 60px 60px;
    animation: grid-drift 20s linear infinite;
  }
  @keyframes grid-drift {
    from { transform: translateY(0); }
    to   { transform: translateY(60px); }
  }

  .hero-vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 30% center, transparent 20%, var(--black) 80%);
    pointer-events: none;
  }

  .hero-scanlines {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(0,0,0,0.15) 2px, rgba(0,0,0,0.15) 4px);
    pointer-events: none;
    opacity: 0.5;
  }

  .hero-side-label {
    position: absolute;
    left: 0px; top: 50%;
    transform: translateY(-50%) rotate(-90deg);
  }
  .side-text {
    display: block;
    font-size: 12px;
    letter-spacing: 0.2em;
    color: var(--text-dim);
    text-transform: uppercase;
    white-space: nowrap;
    animation: fadeUp 0.8s ease 0.8s both;
  }
  .hero-socials {
    position: absolute;
    right: 32px;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    gap: 20px;
    z-index: 2;
    animation: fadeUp 0.8s ease 0.9s both;
  }
  .social-icon {
    color: var(--text-dim);
    transition: color 0.2s, transform 0.2s;
    display: flex;
  }
  .social-icon:hover { 
    color: var(--accent); 
    transform: scale(1.2); 
    filter: drop-shadow(0 0 4px var(--accent));
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    padding-top: 140px;
    padding-bottom: 100px;
    width: 100%;
  }

  .hero-content { 
    max-width: 800px;

  }
  .mono{
    font-size: 13px;
  }

  .hero-tag {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 32px;
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.2em;
    color: var(--text-muted);
    animation: fadeUp 0.8s ease 0.2s both;
  }
  .hero-status {
    width: 8px; height: 8px;
    background: var(--accent);
    border-radius: 50%;
    box-shadow: 0 0 12px var(--accent);
    flex-shrink: 0;
    animation: pulse 2s ease infinite;
  }
  
  @keyframes pulse {
    0%,100% { opacity: 1; box-shadow: 0 0 8px var(--accent); }
    50%      { opacity: 0.5; box-shadow: 0 0 24px var(--accent); }
  }

  .hero-name {
    display: flex;
    flex-direction: column;
    font-family: var(--font-display);
    font-size: clamp(80px, 12vw, 170px);
    line-height: 0.92;
    margin-bottom: 16px;
    margin-top: -12px;
    animation: fadeUp 0.8s ease 0.3s both;
  }
  .hero-name-solid { color: var(--text); }
  .hero-name-outline {
    color: transparent;
    -webkit-text-stroke: 1.5px var(--border-hi);
    transition: -webkit-text-stroke-color 0.3s;
  }
  .hero-name-outline:hover { -webkit-text-stroke-color: var(--accent); }

  .hero-role {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
    animation: fadeUp 0.8s ease 0.4s both;
    white-space: nowrap;
  }
  .role-prefix {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .role-type {
    font-family: var(--font-mono);
    font-size: 22px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    min-width: 2ch;
    display: inline-block;
  }

  .role-prefix, .role-type {
    font-size: 26px;
  }
  .role-cursor {
    color: var(--accent);
    animation: blink 0.7s step-end infinite;
    font-family: var(--font-mono);
    font-size: 14px;
  }
  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  .role-item {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-dim);
    transition: color 0.2s;
  }
  .role-item:hover { color: var(--accent); }
  .role-dot { color: var(--accent); font-size: 16px; line-height: 1; }

  .hero-sub {
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.7;
    animation: fadeUp 0.8s ease 0.5s both;
  }

  .scroll-hint {
    position: absolute;
    bottom: 40px; left: 48.2%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    animation: fadeUp 0.8s ease 1s both;
  }
  .scroll-hint .mono {
    font-size: 14px;
    letter-spacing: 0.2em;
    color: var(--text-dim);
  }
  .scroll-line {
    width: 1px; height: 48px;
    background: linear-gradient(to bottom, var(--accent), transparent);
    animation: scroll-drop 1.8s ease-in-out infinite;
  }
  @keyframes scroll-drop {
    0%   { transform: scaleY(0); transform-origin: top; }
    50%  { transform: scaleY(1); transform-origin: top; }
    51%  { transform: scaleY(1); transform-origin: bottom; }
    100% { transform: scaleY(0); transform-origin: bottom; }
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @media (max-width: 1400px) {
    .hero-side-label { display: none; }
  }
  @media (max-width: 900px) {
    .hero-socials { display: none; }
  }
  @media (max-width: 768px) {
    .hero-photo-bg { width: 100%; right: 0; background-position: 45% top; opacity: 0.3; mask-image: none; -webkit-mask-image: none; }
    .hero-side-label, .hero-socials { display: none; }
    .hero-name { font-size: clamp(52px, 16vw, 80px); }
    .hero-inner {
      padding-left: 24px;
      padding-right: 24px;
    }

    .hero-content {
      margin-left: 0 !important;
      max-width: 100%;
    }

    .hero-tag {
      margin-bottom: 24px;
    }

    .hero-role {
      display: block;
      font-family: var(--font-mono);
      font-size: clamp(14px, 4.5vw, 16px);
      white-space: normal;
      max-width: 28ch;
    }

    .role-prefix, .role-type, .role-cursor {
      font-size: clamp(14px, 4.5vw, 16px);
    }

    .role-type {
      min-width: 0;
      display: inline;
      line-height: 1.5;
      overflow-wrap: break-word;
      word-break: normal;
    }

    .scroll-hint {
      left: 44%;
      transform: translateX(-50%);
      bottom: 32px;
    }
  }
</style>

<script>
  const roles = ['Game Programmer', 'Game Designer', "Game Quality Assurance"];
  let current = 0;
  let charIndex = 0;
  let deleting = false;
  const el = document.getElementById('role-type');
  const cursor = document.querySelector('.role-cursor');

  function type() {
    if (!el) return;
    const word = roles[current];

    if (!deleting) {
      el.textContent = word.slice(0, charIndex + 1);
      charIndex++;
      if (charIndex === word.length) {
        deleting = true;
        setTimeout(type, 3000); // pause before deleting
        return;
      }
    } else {
      el.textContent = word.slice(0, charIndex - 1);
      charIndex--;
      if (charIndex === 0) {
        deleting = false;
        current = (current + 1) % roles.length;
      }
    }

    setTimeout(type, deleting ? 60 : 100);
  }

  type();
</script>
