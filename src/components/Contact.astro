---
const contactLinks = [
  {
    label: 'Email',
    value: 'patrick.alexander1121@gmail.com',
    href: 'mailto:patrick.alexander1121@gmail.com?subject=Inquiry%20from%20Portfolio&body=Hi%20Patrick,%20I%20saw%20your%20work%20and...',
    icon: 'email',
  },
  {
    label: 'LinkedIn',
    value: 'linkedin.com/in/patrick-alexander',
    href: 'https://linkedin.com/in/patrick-alexander21',
    icon: 'linkedin',
  },
  {
    label: 'itch.io',
    value: 'seryxss.itch.io',
    href: 'https://seryxss.itch.io',
    icon: 'itchio',
  },
  {
    label: 'Phone',
    value: '+62 821 5744 4870',
    href: 'https://wa.me/6282157444870',
    icon: 'phone',
  },
];
---

<section class="section" id="contact">
  <div class="container">

    <div class="contact-grid">

      <div class="contact-left">
        <div class="section-label reveal">Contact</div>
        <h2 class="section-title reveal" data-delay="100">LET'S<br/>BUILD<br/>TOGETHER</h2>
        <p class="contact-sub reveal" data-delay="200">
          Open to full-time roles in game development, QA, and collaborative
          projects. Always happy to discuss games, code, or creative ideas.
        </p>

        <div class="contact-cta reveal" data-delay="300">
          <a href="mailto:patrick.alexander1121@gmail.com?subject=Inquiry%20from%20Portfolio&body=Hi%20Patrick,%20I%20saw%20your%20work%20and..." target="_blank" class="cta-main">
            <span>Send a Message</span>
            <span class="cta-arrow">→</span>
          </a>
        </div>
      </div>

      <div class="contact-right">
        <!-- Netlify Contact Form -->
        <form name="contact" method="POST" netlify class="contact-form reveal" data-delay="300">
          <div class="form-group">
            <label for="name" class="form-label">Name</label>
            <input type="text" id="name" name="name" required class="form-input" aria-label="Your name" />
          </div>
          <div class="form-group">
            <label for="email" class="form-label">Email</label>
            <input type="email" id="email" name="email" required class="form-input" aria-label="Your email" />
          </div>
          <div class="form-group">
            <label for="subject" class="form-label">Subject</label>
            <input type="text" id="subject" name="subject" required class="form-input" aria-label="Message subject" />
          </div>
          <div class="form-group">
            <label for="message" class="form-label">Message</label>
            <textarea id="message" name="message" rows="5" required class="form-input form-textarea" aria-label="Your message"></textarea>
          </div>
          <button type="submit" class="form-submit" aria-label="Send message">Send Message</button>
        </form>

        <div class="links-list">
          {contactLinks.map((link, i) => (
            <a
              href={link.href}
              target={'_blank'}
              class="contact-link reveal"
              data-delay={`${i * 80}`}
            >
              <div class="cl-icon">
                {link.icon === 'email' && (
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                )}
                {link.icon === 'linkedin' && (
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
                )}
                {link.icon === 'itchio' && (
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M3.13 1.338C2.08 1.96.02 4.328 0 4.95v1.03c0 1.303 1.22 2.45 2.325 2.45 1.33 0 2.436-1.102 2.436-2.41 0 1.308 1.07 2.41 2.4 2.41 1.328 0 2.362-1.102 2.362-2.41 0 1.308 1.137 2.41 2.466 2.41h.024c1.33 0 2.466-1.102 2.466-2.41 0 1.308 1.034 2.41 2.363 2.41 1.33 0 2.4-1.102 2.4-2.41 0 1.308 1.106 2.41 2.435 2.41C22.78 8.43 24 7.282 24 5.98V4.95c-.02-.62-2.082-2.99-3.13-3.612-3.253-.114-5.508-.134-8.87-.133-3.362 0-7.945.053-8.87.133zm6.376 6.477a2.74 2.74 0 0 1-.468.602c-.5.49-1.19.795-1.947.795a2.786 2.786 0 0 1-1.95-.795c-.182-.178-.32-.37-.446-.59-.127.222-.303.412-.486.59a2.788 2.788 0 0 1-1.95.795c-.092 0-.187-.025-.264-.052-.107 1.113-.152 2.176-.168 2.95v.005l-.006 1.167c.02 2.334-.23 7.564 1.03 8.85 1.952.454 5.545.662 9.15.663 3.605 0 7.198-.21 9.15-.664 1.26-1.284 1.01-6.514 1.03-8.848l-.006-1.167v-.004c-.016-.775-.06-1.838-.168-2.95-.077.026-.172.052-.263.052a2.788 2.788 0 0 1-1.95-.795c-.184-.178-.36-.368-.486-.59-.127.22-.265.412-.447.59a2.786 2.786 0 0 1-1.95.794c-.76 0-1.446-.303-1.948-.793a2.74 2.74 0 0 1-.468-.602 2.738 2.738 0 0 1-.463.602 2.787 2.787 0 0 1-1.95.794h-.16a2.787 2.787 0 0 1-1.95-.793 2.738 2.738 0 0 1-.464-.602zm-2.004 2.59v.002c.795.002 1.5 0 2.373.953.687-.072 1.406-.108 2.125-.107.72 0 1.438.035 2.125.107.873-.953 1.578-.95 2.372-.953.376 0 1.876 0 2.92 2.934l1.123 4.028c.832 2.995-.266 3.068-1.636 3.07-2.03-.075-3.156-1.55-3.156-3.025-1.124.184-2.436.276-3.748.277-1.312 0-2.624-.093-3.748-.277 0 1.475-1.125 2.95-3.156 3.026-1.37-.004-2.468-.077-1.636-3.072l1.122-4.027c1.045-2.934 2.545-2.934 2.92-2.934zM12 12.714c-.002.002-2.14 1.964-2.523 2.662l1.4-.056v1.22c0 .056.56.033 1.123.007.562.026 1.124.05 1.124-.008v-1.22l1.4.055C14.138 14.677 12 12.713 12 12.713z"/></svg>
                )}
                {link.icon === 'phone' && (
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.27h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6 6l.92-.92a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                )}
              </div>
              <div class="cl-body">
                <span class="cl-label mono">{link.label}</span>
                <span class="cl-value">{link.value}</span>
              </div>
              <div class="cl-arrow">↗</div>
            </a>
          ))}
        </div>

        <!-- Location -->
        <div class="location-card reveal" data-delay="400">
          <div class="location-dot"></div>
          <div>
            <div class="mono" style="font-size:10px;letter-spacing:0.2em;color:var(--accent);margin-bottom:4px">LOCATION</div>
            <div style="font-size:14px;color:var(--text-muted)">Surabaya | Samarinda, Indonesia</div>
            <div class="mono" style="font-size:11px;color:var(--text-dim);margin-top:4px">UTC+7|8 · WIB | WITA</div>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  /* Contact Form Styles */
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-bottom: 40px;
    padding: 24px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 4px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .form-label {
    font-size: 12px;
    letter-spacing: 0.2em;
    color: var(--text-dim);
    text-transform: uppercase;
    font-weight: 500;
  }

  .form-input {
    padding: 12px 16px;
    background: var(--surface-1);
    border: 1px solid var(--border);
    border-radius: 4px;
    color: var(--text-primary);
    font-size: 14px;
    font-family: inherit;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .form-input:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(0, 229, 255, 0.1);
  }

  .form-textarea {
    resize: vertical;
    min-height: 120px;
  }

  .form-submit {
    padding: 12px 24px;
    background: var(--accent);
    color: var(--black);
    border: none;
    border-radius: 4px;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.1em;
    cursor: pointer;
    transition: opacity 0.2s, transform 0.2s, box-shadow 0.2s;
    font-family: var(--font-display);
  }

  .form-submit:hover {
    opacity: 0.9;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 229, 255, 0.3);
  }

  .form-submit:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: start;
  }

  .contact-sub {
    font-size: 15px;
    color: var(--text-muted);
    line-height: 1.8;
    max-width: 380px;
    margin-bottom: 48px;
  }

  .contact-cta {}
  .cta-main {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 48px;
    font-family: var(--font-display);
    font-size: 28px;
    color: var(--black);
    background: var(--accent);
    padding: 20px 32px;
    border-radius: 4px;
    transition: opacity 0.2s, transform 0.2s, box-shadow 0.2s;
    position: relative;
    overflow: hidden;
  }

  .cta-main::after {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.3),
      transparent
    );
  }
  .cta-main:hover {
    opacity: 0.9;
    transform: translateY(-3px);
    box-shadow: 0 12px 40px rgba(0,229,255,0.25);
  }

  .cta-main:hover::after {
    left: 100%;
    transition: left 0.7s ease-in-out;
  }
  .cta-arrow {
    transition: transform 0.2s;
  }
  
  .cta-main:hover .cta-arrow {
    transform: translateX(6px);
  }

  /* Links */
  .links-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-bottom: 32px;
  }

  .contact-link {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 20px 0;
    border-bottom: 1px solid var(--border);
    transition: background 0.2s;
    position: relative;
  }
  .contact-link:first-child { border-top: 1px solid var(--border); }
  .contact-link:hover { padding-left: 12px; }

  .cl-icon {
    font-size: 20px;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 4px;
    flex-shrink: 0;
    transition: background 0.2s, border-color 0.2s;
  }
  .cl-icon:hover{
    background: var(--accent-glow);
    border-color: rgba(0,229,255,0.3);
  }

  .contact-link:hover .cl-icon {
    background: var(--accent-glow);
    border-color: rgba(0,229,255,0.3);
  }

  .cl-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .cl-label {
    font-size: 10px;
    letter-spacing: 0.2em;
    color: var(--text-dim);
    text-transform: uppercase;
  }
  .cl-value {
    font-size: 14px;
    color: var(--text-muted);
    transition: color 0.2s;
  }
  .contact-link:hover .cl-value { color: var(--accent); }

  .cl-arrow {
    color: var(--text-dim);
    font-size: 16px;
    transition: color 0.2s, transform 0.2s;
  }
  .contact-link:hover .cl-arrow {
    color: var(--accent);
    transform: translate(3px, -3px);
    
  }

  /* Location */
  .location-card {
    display: flex;
    gap: 16px;
    align-items: center;
    padding: 20px;
    background: var(--surface-2 );
    border: 1px solid var(--border);
    border-radius: 4px;
  }
  .location-dot {
    width: 10px; height: 10px;
    background: var(--accent);
    border-radius: 50%;
    flex-shrink: 0;
    box-shadow: 0 0 16px var(--accent);
    animation: pulse 2s ease infinite;
  }

  @media (max-width: 900px) {
    .contact-grid { grid-template-columns: 1fr; gap: 48px; }
  }
</style>
