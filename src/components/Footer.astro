---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-inner">
    <div class="footer-left">
      <span class="footer-logo">[PA]</span>
      <span class="footer-copy mono">© {year} Patrick Alexander. All rights reserved.</span>
    </div>
    <div class="footer-right mono">
      <span style="color:var(--text-dim)">Built with</span>
      <span style="color:var(--accent)">Astro JS</span>
      <span style="color:var(--text-dim)">·</span>
      <span style="color:var(--text-dim)">Deployed with love</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    padding: 32px 0;
    background: var(--black);
  }
  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
  }
  .footer-left {
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .footer-logo {
    font-family: var(--font-display);
    font-size: 20px;
    color: var(--accent);
  }
  .footer-copy {
    font-size: 11px;
    color: var(--text-dim);
    letter-spacing: 0.08em;
  }
  .footer-right {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    letter-spacing: 0.08em;
  }

  @media (max-width: 600px) {
    .footer-inner { flex-direction: column; align-items: flex-start; }
  }
</style>
