<style>
  #about{
    padding-bottom: 7%;
  }
  #about .section-title {
    margin-bottom: 24px;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1.2fr .8fr;
    gap: 100px;
    align-items: start;
  }

  .about-body {
    color: var(--text-muted);
    line-height: 1.8;
    margin-bottom: 10px;
    font-size: 16px;
  }

  .about-details {
    margin: 32px 0;
    border: 1px solid var(--border);
    border-radius: 4px;
    overflow: hidden;
  }
  .detail-row {
    display: flex;
    padding: 12px 20px;
    border-bottom: 1px solid var(--border);
    font-size: 14px;
  }
  .detail-row:last-child { border-bottom: none; }
  .detail-key {
    font-family: var(--font-mono);
    color: var(--text-dim);
    letter-spacing: 0.1em;
    font-size: 11px;
    text-transform: uppercase;
    min-width: 100px;
    align-self: center;
  }
  .detail-val { color: var(--text-muted); }
  .detail-link { color: var(--accent); transition: opacity 0.2s; }
  .detail-link:hover { opacity: 0.75; }

  /* CTAs */
  .about-cta { display: flex; gap: 12px; flex-wrap: wrap; }
  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    letter-spacing: 0.12em;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--black);
    background: var(--accent);
    padding: 12px 24px;
    border-radius: 2px;
    font-weight: 500;
    transition: opacity 0.2s, transform 0.2s, box-shadow 0.2s;
    position: relative;
    overflow: hidden;
  }
  .btn-primary::after {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.3),
      transparent
    );
    transition: left 0.5s ease;
  }
  .btn-primary:hover {
    opacity: 0.9;
    transform: translateY(-2px);
    box-shadow: 0 12px 24px rgba(0,229,255,0.25);
  }

  .btn-primary:hover::after {
    left: 100%;
    transition: left 0.77s ease;
  }
  .btn-ghost {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    border: 1px solid var(--border-hi);
    padding: 14px 24px;
    border-radius: 2px;
    transition: color 0.2s, border-color 0.2s;
  }
  .btn-ghost:hover { color: var(--accent); border-color: var(--accent); }

  /* Right column */
  .about-visual {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .photo-wrap {
    position: relative;
    width: 100%;
    max-height: 100%;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border-radius: 4px;
  }
  .about-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    filter: grayscale(100%) contrast(1.05);
    transition: filter 0.4s ease, transform 0.6s ease;
  }
  .photo-wrap:hover .about-photo {
    filter: grayscale(60%) contrast(1.05);
    transform: scale(1.03);
  }

  .photo-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,229,255,0.18) 0%, transparent 50%);
    mix-blend-mode: screen;
    pointer-events: none;
  }

  .photo-corner {
    position: absolute;
    width: 24px; height: 24px;
    pointer-events: none;
  }

  .photo-corner-tl {
    top: 12px; left: 12px;
    border-top: 1.5px solid var(--accent);
    border-left: 1.5px solid var(--accent);
    opacity: 1;
  }
  .photo-corner-br {
    bottom: 12px; right: 12px;
    border-bottom: 1.5px solid var(--accent);
    border-right: 1.5px solid var(--accent);
    opacity: 1;
  }
  .photo-nametag {
    position: absolute;
    bottom: 16px; left: 16px;
    display: flex;
    align-items: center;
    gap: 8px;
    background: rgba(5,8,16,0.75);
    backdrop-filter: blur(8px);
    border: 1px solid var(--border-hi);
    padding: 8px 14px;
    border-radius: 2px;
    max-width: calc(100% - 32px);
  }
  .badge-dot {
    width: 6px; height: 6px;
    background: var(--accent);
    border-radius: 50%;
    flex-shrink: 0;
    animation: pulse 2s ease infinite;
  }
  .about-card {
    background: #0a1118; 
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 32px;
    position: relative;
    overflow: hidden;
  }
  .about-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(0, 229, 255, 0.12) 0%, transparent 50%);
    pointer-events: none;
  }
  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 30px; 
    margin-bottom: 24px;
  }

  .card-emblem {
    width: 210px; 
    height: auto;
    filter: brightness(1.4) drop-shadow(0 0 15px rgba(0, 229, 255, 0.3));
    opacity: 1;
    transition: transform 0.3s ease;
  }
  .card-emblem:hover {
    transform: scale(1.2) rotate(2deg);
    filter: brightness(1.4) drop-shadow(0 0 20px rgba(0, 229, 255, 0.4));
  }
  .emblem-container {
    transform: translateX(-55px);
    flex-shrink: 0; /* Prevents the icon from squishing */
  }

  .card-quote {
    font-family: var(--font-display);
    font-size: 30px;
    line-height: 1.15;
    color: var(--text);
    margin-bottom: 0px;
    min-width: 200px;
  }

  .card-traits {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .trait {
    background: rgba(255, 255, 255, 0.03); /* Semi-transparent */
    border: 2px solid rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(4px); /* Subtle glass effect */
    color: var(--text-muted);
    font-size: 12px;
    padding: 5px 12px;
  }
  .trait:hover {
    color: var(--accent);
    border-color: rgba(0,229,255,0.3);
    background: var(--accent-glow);
  }

  .deco-corner {
    position: absolute;
    bottom: -16px; left: -16px;
    width: 32px; height: 32px;
    border-left: 1px solid var(--accent);
    border-bottom: 1px solid var(--accent);
    opacity: 0.3;
  }

  @media (max-width: 900px) {
    .about-grid { grid-template-columns: 1fr; gap: 48px; }
    .photo-wrap { aspect-ratio: 4 / 3; }
  }

  @media (max-width: 480px) {
    .card-header {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      text-align: left;
    }

    .card-quote {
      min-width: 0;
      font-size: 24px;
      line-height: 1.1;
      flex: 1;
    }

    .emblem-container {
      transform: none;
      display: flex;
      justify-content: flex-end;
      align-items: center;
      flex-shrink: 0;
    }

    .card-emblem {
      width: 96px;
    }

    .photo-nametag {
      left: 12px;
      right: 12px;
      bottom: 12px;
      padding: 8px 12px;
    }

    .photo-nametag .mono {
      font-size: 9px !important;
      letter-spacing: 0.12em !important;
    }
  }
</style>
