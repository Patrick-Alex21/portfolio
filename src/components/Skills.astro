---

<section class="section" id="skills" style="background: var(--deep);" >
  <div class="container">

    <div class="section-label reveal">Skills</div>
    <h2 class="section-title reveal" data-delay="100">WHAT I<br/>WORK WITH</h2>

    <div class="skills-grid">

      <!-- Tech Skills with bars -->
      <div class="skills-bars reveal" data-delay="150">
        <h3 class="skills-sub">Technical Skills</h3>
        <div class="bars">
          {techSkills.map((skill, i) => (
            <div class="bar-row" style={`--delay:${i * 80}ms`}>
              <div class="bar-header">
                <span class="bar-icon">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" set:html={icons[skill.icon]} />
                </span>
                <span class="bar-name">{skill.name}</span>
                <span class="bar-num mono">{skill.level}%</span>
              </div>
              <div class="bar-track">
                <div class="bar-fill" style={`--w:${skill.level}%`}></div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Soft Skills + Tools -->
      <div class="skills-right">
        <div class="soft-skills reveal" data-delay="200">
          <h3 class="skills-sub">Soft Skills</h3>
          <ul class="soft-list">
            {softSkills.map(skill => (
              <li class="soft-item">
                <span class="soft-arrow">→</span>
                {skill}
              </li>
            ))}
          </ul>
        </div>

        <div class="tools-section reveal" data-delay="300">
          <h3 class="skills-sub">Tools</h3>
          <div class="tools-cloud">
            {tools.map(tool => (
              <span class="tool-chip">{tool}</span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .skills-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: start;
  }

  .skills-sub {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 20px;
  }

  .bars { display: flex; flex-direction: column; gap: 20px; }

  .bar-row {
    animation: barReveal 0.6s ease var(--delay, 0ms) both;
  }
  @keyframes barReveal {
    from { opacity: 0; transform: translateX(-12px); }
    to   { opacity: 1; transform: translateX(0); }
  }

  .bar-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 8px;
  }
  .bar-icon {
    width: 20px;
    height: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-dim);
    flex-shrink: 0;
  }
  .bar-name {
    flex: 1;
    font-size: 16px;
    color: var(--text-muted);
  }
  .bar-num {
    font-size: 11px;
    color: var(--text-dim);
  }
  .bar-track {
    height: 3px;
    background: var(--border);
    border-radius: 4px;
    overflow: hidden;
  }
  .bar-fill {
    height: 100%;
    width: 0;
    background: linear-gradient(to right, var(--accent-dim), var(--accent));
    border-radius: 4px;
    transition: width 0.4s ease-out; 
    transition-delay: 0s;
    will-change: width;
  }

  .bars-visible .bar-fill {
    width: var(--w);
    transition: width 1.2s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: var(--delay);
  }

  .skills-right { display: flex; flex-direction: column; gap: 48px; }
  .soft-list { list-style: none; display: flex; flex-direction: column; gap: 10px; }

  .soft-item {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 14px;
    color: var(--text-muted);
    padding: 8px 0;
    border-bottom: 1px solid var(--border);
    transition: color 0.2s;
  }
  .soft-item:hover { color: var(--text); }
  .soft-arrow { color: var(--accent); font-size: 12px; }

  .tools-cloud { display: flex; flex-wrap: wrap; gap: 8px; }
  .tool-chip {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    border: 1px solid var(--border);
    padding: 6px 12px;
    border-radius: 4px;
    transition: color 0.2s, border-color 0.2s, background 0.2s;
    cursor: default;
  }
  .tool-chip:hover {
    color: var(--accent);
    border-color: rgba(0,229,255,0.3);
    background: var(--accent-glow);
  }

  @media (max-width: 900px) {
    .skills-grid { grid-template-columns: 1fr; gap: 48px; }
  }
</style>

<script>
  const initBars = () => {
    const barsContainer = document.querySelector('.bars');
    if (!barsContainer) return;

    const observerOptions = {
      threshold: 0.1, 
      rootMargin: '0px 0px -50px 0px' 
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('bars-visible');
        } else {
          entry.target.classList.remove('bars-visible');
        }
      });
    }, observerOptions);

    observer.observe(barsContainer);
  };

  initBars();
  document.addEventListener('astro:after-swap', initBars);
</script>