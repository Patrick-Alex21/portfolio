---
import { getCollection, render } from 'astro:content'; import type { CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project: CollectionEntry<'projects'>) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props as { project: CollectionEntry<'projects'> };
const { Content } = await render(project);
const { title, type, period, shortDesc, tags, images, link } = project.data;
---

<Layout title={`${title} - Patrick Alexander`} description={shortDesc}>
  <article class="project-page">
    <a class="project-back" href="/#projects">&lt;- Back to projects</a>
    <header class="project-header">
      <p class="eyebrow">{type} &middot; {period}</p>
      <h1>{title}</h1>
      <p class="project-summary">{shortDesc}</p>
      <div class="project-tags">
        {tags.map((tag: string) => <span>{tag}</span>)}
      </div>
      {link && <a class="project-link" href={link} target="_blank" rel="noreferrer">View project -&gt;</a>}
    </header>
    {images.length > 0 && (
      <div class="project-gallery">
        {images.map((image: string) => <img src={image} alt={`${title} screenshot`} loading="lazy" />)}
      </div>
    )}
    <div class="project-content"><Content /></div>
  </article>
</Layout>

<style>
  .project-page { max-width: 980px; margin: 0 auto; padding: 9rem 2rem 6rem; }
  .project-back { color: var(--muted, #999); text-decoration: none; }
  .project-header { margin: 3rem 0; }
  .eyebrow { color: var(--accent); text-transform: uppercase; letter-spacing: .12em; font-size: .8rem; }
  h1 { font-size: clamp(3rem, 8vw, 6rem); line-height: .95; margin: 1rem 0; }
  .project-summary { max-width: 650px; font-size: 1.25rem; color: var(--muted, #999); }
  .project-tags { display: flex; flex-wrap: wrap; gap: .5rem; margin: 2rem 0; }
  .project-tags span { border: 1px solid currentColor; border-radius: 999px; padding: .4rem .8rem; font-size: .8rem; }
  .project-link { color: var(--accent); }
  .project-gallery { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem; }
  .project-gallery img { width: 100%; border-radius: 1rem; }
  .project-content { max-width: 680px; margin: 4rem auto 0; line-height: 1.7; }
  .project-content :global(h2) { margin-top: 3rem; }
</style>
