---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found | Patrick Alexander" description="This page does not exist.">
  <section class="nf">
    <h1>404</h1>
    <p>Page not found.</p>
    <a href="/">Back to home</a>
  </section>
</Layout>

<style>
  .nf { min-height: 100vh; display: grid; place-content: center; text-align: center; gap: 1rem; }
  .nf h1 { font-family: var(--font-display); font-size: clamp(6rem, 20vw, 12rem); line-height: 1; }
  .nf a { color: var(--accent); }
</style>
