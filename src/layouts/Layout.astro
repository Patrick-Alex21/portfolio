---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Patrick Alexander — Portfolio',
  description = 'Game Developer. Building worlds in Unity and Unreal Engine.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <meta>
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://Patrick-Portfolio-Dev.netlify.app" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/public/Art.png" />
    <!-- <meta property="og:image" content="https://d2xsxph8kpxj0f.cloudfront.net/310519663555758282/TM7djaEH7p6W88f4aQtczH/patrick-og-image-7fHdfg2Asa8mCnxXryDmAt.webp" />-->
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content="https://d2xsxph8kpxj0f.cloudfront.net/310519663555758282/TM7djaEH7p6W88f4aQtczH/patrick-og-image-7fHdfg2Asa8mCnxXryDmAt.webp" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="keywords" content="game developer, unity, unreal engine, game programmer, QA, game design" />
    <meta name="author" content="Patrick Alexander" />
    <meta name="robots" content="index, follow" />
    <link rel="icon" type="image/svg+xml" href="/PA.svg" />
    <link rel="canonical" href="https://patrickalexander-dev.netlify.app" />
    <title>{title}</title>

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json">
    {JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Patrick Alexander",
      "url": "https://patrickalexander-dev.netlify.app",
      "jobTitle": "Game Developer and QA Specialist",
      "image": "https://d2xsxph8kpxj0f.cloudfront.net/310519663555758282/TM7djaEH7p6W88f4aQtczH/patrick-og-image-7fHdfg2Asa8mCnxXryDmAt.webp",
      "description": "Game Developer specializing in Unity C# and Unreal Engine. Based in Indonesia. Open to full-time opportunities in game development and QA.",
      "sameAs": [
        "https://linkedin.com/in/patrick-alexander",
        "https://github.com/seryxss",
        "https://itch.io/profile/seryxss"
      ],
      "location": {
        "@type": "Place",
        "name": "Surabaya / Samarinda, Indonesia"
      },
      "knowsAbout": [
        "Unity",
        "Unreal Engine",
        "Game Programming",
        "Game Design",
        "Quality Assurance",
        "C#",
        "Blueprints",
        "3D Game Development"
      ]
    })}
    </script>

    <!-- Preload fonts -->
     <link 
      rel="preload" 
      href="https://fonts.gstatic.com/s/bebasneue/v14/JTUSjIg69CK48gW7PXoo9WlHyw.woff2" 
      as="font" 
      type="font/woff2" 
      crossorigin 
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-GVC7WXFKFT"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){window.dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-GVC7WXFKFT');
    </script>
  </head>

  <body>
    <!-- Custom Cursor -->
    <div class="cursor" id="cursor-dot"  style="position:fixed;top:0;left:0;z-index:9999;pointer-events:none;">
      <div class="cursor-dot"></div>
    </div>
    <div class="cursor" id="cursor-ring" style="position:fixed;top:0;left:0;z-index:9998;pointer-events:none;">
      <div class="cursor-ring"></div>
    </div>

    <a href="#main" class="skip-link">Skip to main content</a>
    <Nav />
    <main id="main" role="main">
      <slot />
    </main>
    <Footer />

    <script>
      const dot  = document.getElementById('cursor-dot')!;
      const ring = document.getElementById('cursor-ring')!;
      let mx = 0, my = 0, rx = 0, ry = 0;

      // Update the script block in Layout.astro
      document.addEventListener('mousemove', (e) => {
        mx = e.clientX; 
        my = e.clientY;
        // Use transform for better performance (GPU accelerated)
        dot.style.transform = `translate3d(${mx}px, ${my}px, 0)`;
      });

      document.addEventListener('mousedown', () => {
        ring.classList.add('cursor-clicking');
      });

      document.addEventListener('mouseup', () => {
        ring.classList.remove('cursor-clicking');
      });

      function animateRing() {
        rx += (mx - rx) * 0.5; 
        ry += (my - ry) * 0.5;
        // Use transform for the ring as well
        ring.style.transform = `translate3d(${rx}px, ${ry}px, 0)`;
        requestAnimationFrame(animateRing);
      }
      animateRing();

      // Scroll reveal
      const initReveal = () => {
      // Use the class you already have (likely .reveal)
      const revealSections = document.querySelectorAll('.reveal');

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            // SPAWN: Add the class when it hits the screen
            entry.target.classList.add('spawned');
          } else {
            // UNREVEAL: Remove it when it leaves the screen
            // This is what makes it reset like your skill bars
            entry.target.classList.remove('spawned');
          }
        });
      }, { 
        threshold: 0.1, // Trigger when 10% is visible
        rootMargin: "0px 0px -10px 0px"
      });

      revealSections.forEach(section => observer.observe(section));
    };

    initReveal();
    document.addEventListener('astro:after-swap', initReveal);
    </script>
  </body>
</html>