---
import { Font } from 'astro:assets';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Patrick Alexander — Dev Portfolio',
  description = 'Game Developer, specializing in Unity and Unreal Engine, game design, and interactive experiences.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Patrick Alexander',
  alternateName: ['Patrick Alexander Portfolio', 'Patrick Alex'],
  url: 'https://patrick-alexander.dev',
};

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Patrick Alexander',
  url: 'https://patrick-alexander.dev',
  jobTitle: 'Game Developer and QA Specialist',
  image: 'https://patrick-alexander.dev/logo.png',
  description:
    'Game Developer specializing in Unity C# and Unreal Engine. Open to full-time opportunities in game development and QA.',
  sameAs: [
    'https://linkedin.com/in/patrick-alexander21',
    'https://github.com/Patrick-Alex21',
    'https://itch.io/profile/seryxss',
  ],
  homeLocation: {
    '@type': 'Place',
    name: 'Surabaya / Samarinda, Indonesia',
  },
  knowsAbout: [
    'Patrick Alexander',
    'Unity',
    'Unreal Engine',
    'Game Programming',
    'Game Design',
    'Quality Assurance',
    'C#',
    'Blueprints',
    'Game Development',
    'Game Developer',
    'Level Design',
    'VR/AR Development',
    'Web Development',
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta property="og:site_name" content="Patrick Alexander" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://patrick-alexander.dev/Thumbnail.jpg" />
    <meta property="og:image:alt" content="Patrick Alexander portfolio" />
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="1200">
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta name="twitter:image" content="https://patrick-alexander.dev/Thumbnail.png">
    <meta name="description" content={description} />
    <meta name="author" content="Patrick Alexander" />
    <meta name="robots" content="index, follow, max-image-preview:none">
    <link rel="icon" type="image/png" sizes="192x192" href="/icon.png" />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <slot name="head" />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />

    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-body" preload />
    <Font cssVariable="--font-mono" />

    <!-- Google Analytics -->
    <script is:inline>
    addEventListener('load', () => setTimeout(() => {
      const s = document.createElement('script');
      s.src = 'https://www.googletagmanager.com/gtag/js?id=G-GVC7WXFKFT';
      document.head.appendChild(s);
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments)}
      gtag('js', new Date());
      gtag('config', 'G-GVC7WXFKFT');
    }, 2000));
  </script>
  </head>

  <body>
    <!-- Custom Cursor -->
    <div class="cursor" id="cursor-dot"  style="position:fixed;top:0;left:0;z-index:9999;pointer-events:none;">
      <div class="cursor-dot"></div>
    </div>
    <div class="cursor" id="cursor-ring" style="position:fixed;top:0;left:0;z-index:9998;pointer-events:none;">
      <div class="cursor-ring"></div>
    </div>

    <a href="#main" class="skip-link">Skip to main content</a>
    <Nav />
    <main id="main" role="main">
      <slot />
    </main>
    <Footer />

    <script>
      const dot  = document.getElementById('cursor-dot')!;
      const ring = document.getElementById('cursor-ring')!;
      let mx = 0, my = 0, rx = 0, ry = 0;

      // Update the script block in Layout.astro
      document.addEventListener('mousemove', (e) => {
        mx = e.clientX;
        my = e.clientY;
        dot.style.opacity = ring.style.opacity = '1';
        dot.style.transform = `translate3d(${mx}px, ${my}px, 0)`;
      });

      document.addEventListener('mousedown', (e) => {
        if (e.clientX >= document.documentElement.clientWidth) {
          dot.style.opacity = ring.style.opacity = '0'; // clicked the scrollbar
          return;
        }
        ring.classList.add('cursor-clicking');
      });

      document.addEventListener('mouseleave', () => {
        dot.style.opacity = ring.style.opacity = '0';
      });

      function animateRing() {
        if (matchMedia('(pointer: fine)').matches) {
          rx += (mx - rx) * 0.4; 
          ry += (my - ry) * 0.5;
          // Use transform for the ring as well
          ring.style.transform = `translate3d(${rx}px, ${ry}px, 0)`;
          requestAnimationFrame(animateRing);
        }
      }
      animateRing();

      // Scroll reveal
      const initReveal = () => {
      // Use the class you already have (likely .reveal)
      const revealSections = document.querySelectorAll('.reveal');

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('spawned');
            observer.unobserve(entry.target);
          }
        });
      }, { 
        threshold: 0.1, // Trigger when 10% is visible
        rootMargin: "0px 0px -10px 0px"
      });

      revealSections.forEach(section => observer.observe(section));
    };

    initReveal();
    document.addEventListener('astro:after-swap', initReveal);
    </script>
  </body>
</html>